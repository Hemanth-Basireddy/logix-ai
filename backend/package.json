{
  "name": "@logix-ai/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/employee.test.ts src/company-events.test.ts src/company-admin-employees.test.ts src/role-hub-data.test.ts src/operations-data.test.ts src/hub-manager-data.test.ts src/transport.test.ts src/logistics-executive-data.test.ts src/customer-portal.test.ts src/customer-dashboard.test.ts src/auth.test.ts src/database-target.test.ts",
    "test:customer-integration": "node --import tsx --test src/customer-portal.integration.test.ts",
    "migrate:plaintext-passwords": "tsx scripts/migrate-plaintext-passwords.ts",
    "preflight:plaintext-passwords": "tsx scripts/migrate-plaintext-passwords.ts --preflight",
    "reset:admin-password": "tsx scripts/reset-admin-password.ts",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6"
  }
}
