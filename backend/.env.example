NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=logistics_db
DB_USER=root
DB_PASSWORD=replace-with-local-db-password
# Customer portal integration tests require a separately provisioned, disposable
# MySQL database. Set these in the test process/environment, not the application DB fields.
# LOGIX_DB_MODE=test
# LOGIX_TEST_DB_HOST=127.0.0.1
# LOGIX_TEST_DB_PORT=3306
# LOGIX_TEST_DB_NAME=logix_customer_test_local
# LOGIX_TEST_DB_USER=logix_test
# LOGIX_TEST_DB_PASSWORD=replace-with-test-only-password
# Set CUSTOMER_PORTAL_COMPANY_ID to a tenant's company_id to enable customer routes.
# The server derives company scope from this setting; clients cannot select it.
CUSTOMER_PORTAL_MODE=public
# Set to demo only on an access-controlled demo/beta deployment. This enables
# phone-only matching for imported historical demo identities; never enable it
# on a public production customer portal.
CUSTOMER_OTP_TWILIO_ACCOUNT_SID=
CUSTOMER_OTP_TWILIO_AUTH_TOKEN=
CUSTOMER_OTP_TWILIO_VERIFY_SERVICE_SID=
# Required to send OTPs for historical local-format phone numbers without a + prefix.
# Use the deployment's actual international calling code; never infer it from a phone's length.
CUSTOMER_OTP_DEFAULT_COUNTRY_CODE=
# Demo UPI completion is simulated and never bank-confirmed. Defaults on in
# non-production environments; set DEMO_PAYMENTS_ENABLED=true explicitly only
# for an intentionally access-controlled production demo.
DEMO_PAYMENTS_ENABLED=false
# Optional tenant assets/colors keyed by company_id. Company names always come from MySQL.
COMPANY_BRANDING_JSON={}
